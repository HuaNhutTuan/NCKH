# Sao chép file này thành ".env" rồi điền thông tin thật của bạn
# KHÔNG commit file ".env" thật lên git

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=loc_app

# JWT — đổi thành một chuỗi ngẫu nhiên dài, giữ bí mật
JWT_SECRET=change_this_to_a_long_random_secret

# Server
PORT=4000
# Domain của frontend được phép gọi API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Google Gemini API Key (Lấy miễn phí tại https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
