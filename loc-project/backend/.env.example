# Sao chép file này thành ".env" rồi điền thông tin thật của bạn
# KHÔNG commit file ".env" thật lên git

# ─── Môi trường ────────────────────────────────────────────────────────────────
NODE_ENV=development

# ─── MySQL ─────────────────────────────────────────────────────────────────────
# KHUYẾN NGHỊ BẢO MẬT: Tạo MySQL user riêng thay vì dùng root
# CREATE USER 'loc_app_user'@'%' IDENTIFIED BY 'MatKhauManh!2026';
# GRANT SELECT, INSERT, UPDATE, DELETE ON loc_app.* TO 'loc_app_user'@'%';
DB_HOST=localhost
DB_PORT=3306
DB_USER=loc_app_user
DB_PASSWORD=your_strong_mysql_password
DB_NAME=loc_app

# ─── JWT ───────────────────────────────────────────────────────────────────────
# Tạo secret ngẫu nhiên bằng lệnh:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_byte_random_hex_secret_here
JWT_EXPIRES_IN=24h

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=4000
# Danh sách domain frontend được phép gọi API (CORS), ngăn cách bởi dấu phẩy
CLIENT_ORIGIN=http://localhost:5173

# ─── Admin ─────────────────────────────────────────────────────────────────────
# Email của tài khoản Admin đầu tiên
ADMIN_EMAIL=your_admin_email@example.com

# ─── Google Gemini API Key ─────────────────────────────────────────────────────
# Lấy miễn phí tại https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

